{
  "name": "begapunk-site-v2",
  "version": "1.0.0",
  "private": true,
  "description": "Build and quality-assurance tooling for the Begapunk static website.",
  "scripts": {
    "build:minify": "node scripts/build-minified-site.mjs",
    "build:minify:verify": "node scripts/verify-minified-site.mjs",
    "i18n:extract": "node scripts/build-localized-site.mjs --mode extract",
    "i18n:translate": "node scripts/build-localized-site.mjs --mode translate",
    "i18n:build": "node scripts/build-localized-site.mjs --mode build",
    "i18n:refresh-metadata": "node scripts/build-localized-site.mjs --mode refresh-metadata",
    "i18n:integrate": "node scripts/build-localized-site.mjs --mode integrate",
    "i18n:verify": "node scripts/verify-localized-site.mjs",
    "discovery:sync": "node scripts/sync-discovery-exclusions.mjs",
    "discovery:verify": "node scripts/sync-discovery-exclusions.mjs --check",
    "soft-isolation:verify": "node scripts/sync-soft-isolation-content.mjs --check",
    "inquiry:verify": "node scripts/verify-inquiry-contract.mjs",
    "inquiry:php:verify": "node scripts/verify-inquiry-php-runtime.mjs",
    "product-trust:sync": "node scripts/sync-product-trust-content.mjs",
    "product-trust:verify": "node scripts/sync-product-trust-content.mjs --check",
    "faq-trust:sync": "node scripts/sync-faq-trust-content.mjs",
    "faq-trust:verify": "node scripts/sync-faq-trust-content.mjs --check",
    "ai-trust-overrides:sync": "node scripts/sync-ai-trust-overrides.mjs",
    "ai-trust-overrides:verify": "node scripts/sync-ai-trust-overrides.mjs --check",
    "owner-facts:sync": "node scripts/sync-owner-confirmed-facts.mjs",
    "owner-facts:translations:verify": "node scripts/sync-owner-confirmed-facts.mjs --check",
    "owner-facts:verify": "node scripts/verify-owner-confirmed-facts.mjs",
    "editorial:release:verify": "node scripts/verify-editorial-release-status.mjs",
    "unsafe-orphans:prune": "node scripts/prune-unsafe-orphan-overrides.mjs",
    "unsafe-orphans:verify": "node scripts/prune-unsafe-orphan-overrides.mjs --check",
    "search:sync": "node scripts/sync-search-index.mjs",
    "search:verify": "node scripts/sync-search-index.mjs --check",
    "navigation:sync": "node scripts/sync-site-navigation.mjs",
    "inspection:sync": "node scripts/sync-production-inspection-pages.mjs",
    "quality:breadcrumbs:sync": "node scripts/sync-quality-breadcrumbs.mjs",
    "case:breadcrumbs:sync": "node scripts/sync-case-breadcrumbs.mjs",
    "images:audit": "node scripts/optimize-images.mjs --audit",
    "images:optimize": "node scripts/optimize-images.mjs --write",
    "images:verify": "node scripts/verify-optimized-images.mjs",
    "social:generate": "node scripts/generate-social-images.mjs",
    "social:verify": "node scripts/verify-social-images.mjs",
    "pdf:metadata:check": "python scripts/update-pdf-metadata.py",
    "pdf:metadata:write": "python scripts/update-pdf-metadata.py --write",
    "downloads:manifest": "node scripts/generate-public-downloads-manifest.mjs",
    "products:validate": "node scripts/validate-product-data.mjs",
    "audit:product-truth": "node scripts/audit-product-truth.mjs",
    "quality": "npm run quality:pr",
    "quality:source": "node scripts/validate-source-quality.mjs",
    "collab:validate": "node scripts/validate-collaboration-model.mjs",
    "quality:pr": "npm run collab:validate && npm run product-trust:verify && npm run faq-trust:verify && npm run ai-trust-overrides:verify && npm run owner-facts:translations:verify && npm run unsafe-orphans:verify && npm run soft-isolation:verify && npm run inquiry:verify && npm run discovery:verify && npm run search:verify && npm run i18n:verify && npm run owner-facts:verify && npm run products:validate && npm run images:verify && npm run social:verify && npm run quality:source && npm run deploy:build && npm run claims:verify && npm run deploy:validate",
    "deploy:build": "node scripts/build-production-release.mjs",
    "claims:verify": "node scripts/verify-public-claims.mjs",
    "deploy:validate": "node scripts/validate-deployment.mjs dist/production",
    "deploy:prepare": "npm run i18n:refresh-metadata && npm run product-trust:verify && npm run faq-trust:verify && npm run ai-trust-overrides:verify && npm run owner-facts:translations:verify && npm run unsafe-orphans:verify && npm run soft-isolation:verify && npm run inquiry:verify && npm run discovery:verify && npm run search:verify && npm run i18n:verify && npm run owner-facts:verify && npm run editorial:release:verify && npm run products:validate && npm run images:verify && npm run social:verify && npm run quality:source && npm run deploy:build && npm run claims:verify && npm run deploy:validate"
  },
  "devDependencies": {
    "cheerio": "1.1.2",
    "clean-css": "^5.3.3",
    "html-minifier-terser": "^7.2.0",
    "sharp": "0.35.3",
    "terser": "^5.49.0"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "fuse.js": "7.0.0"
  }
}
